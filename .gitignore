# Build trees and packaged output
/build/
/build-*/
/dist/
/saves/

# Local probe output that names paths on one machine
/rom_probe.json

# Launcher/runtime state written beside the executable (and in the repo root
# when the game is run from there): the cached ROM path, keybinds, settings.
# All of it is one machine's, none of it is the project's.
/rom.cfg
/keybinds.ini
/config.ini
/input.ini

.DS_Store

# Local bootstrap checkout and tools
/.bootstrap/
/.tools/

# Local runtime reports and user mod preferences
/last_run_report.json
/crash_report_*.json
/crash_minidump_*.dmp
/logs/
/mods/preloaded/state.toml

# Secrets and machine-local caches
.env
